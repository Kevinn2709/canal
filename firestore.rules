rules_version = '2';

// Reglas de seguridad de Firestore para el chat cifrado.
//
// 1) Reemplaza UID_TUYO y UID_DE_TU_SOCIO por los UID reales de las dos
//    cuentas (Firebase -> Authentication -> Users -> columna "User UID").
// 2) Pega este archivo completo en Firebase -> Firestore Database -> Rules
//    y pulsa "Publish".

service cloud.firestore {
  match /databases/{database}/documents {

    function isMember() {
      return request.auth != null
        && request.auth.uid in ['53RqgaavXfZDCd0Ln00OMwGlGnF2', 'cqjDflCzPyb1gYwU7EklOpYVSk02'];
    }

    // Un mensaje: solo texto cifrado, a nombre de quien lo envía.
    function validMessage() {
      let d = request.resource.data;
      return d.keys().hasAll(['ct', 'iv', 'uid', 'createdAt'])
        && d.keys().hasOnly(['ct', 'iv', 'uid', 'createdAt', 'v'])
        && d.uid == request.auth.uid
        && d.ct is string
        && d.ct.size() > 0
        && d.ct.size() <= 20000
        && d.iv is string
        && d.iv.size() == 16
        && d.createdAt == request.time
        && (!d.keys().hasAny(['v']) || d.v == 2);
    }

    // Datos públicos del cifrado: la sal y la prueba de verificación de la
    // frase. No contienen la frase ni la llave. Se crea una sola vez.
    match /meta/crypto {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(
             ['salt', 'iterations', 'checkIv', 'checkCt', 'createdBy', 'createdAt'])
        && request.resource.data.salt is string
        && request.resource.data.salt.size() == 24
        && request.resource.data.iterations is number
        && request.resource.data.iterations >= 100000
        && request.resource.data.iterations <= 10000000
        && request.resource.data.checkIv is string
        && request.resource.data.checkIv.size() == 16
        && request.resource.data.checkCt is string
        && request.resource.data.checkCt.size() < 200
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Conversación "General": el historial original.
    match /messages/{messageId} {
      allow read: if isMember();
      allow create: if isMember() && validMessage();
      allow update, delete: if false;
    }

    // Conversaciones. El nombre y el proyecto van cifrados (metaIv, metaCt).
    // Se pueden renombrar, archivar y marcar la hora del último mensaje,
    // pero nunca borrar.
    match /chats/{chatId} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(
             ['metaIv', 'metaCt', 'createdBy', 'createdAt', 'lastMessageAt',
              'lastMessageBy', 'archived'])
        && request.resource.data.metaIv is string
        && request.resource.data.metaIv.size() == 16
        && request.resource.data.metaCt is string
        && request.resource.data.metaCt.size() <= 2000
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.lastMessageBy == request.auth.uid
        && request.resource.data.archived == false;
      allow update: if isMember() && (
        (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastMessageAt', 'lastMessageBy'])
          && request.resource.data.lastMessageAt == request.time
          && request.resource.data.lastMessageBy == request.auth.uid)
        || (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['metaIv', 'metaCt'])
          && request.resource.data.metaIv is string
          && request.resource.data.metaIv.size() == 16
          && request.resource.data.metaCt is string
          && request.resource.data.metaCt.size() <= 2000)
        || (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['archived'])
          && request.resource.data.archived is bool)
      );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isMember();
        allow create: if isMember() && validMessage();
        allow update, delete: if false;
      }

      // Reacciones: una por persona y mensaje ({mensaje}_{uid}). El emoji va
      // cifrado; quitarla la deja vacía. Cada quien solo toca la suya.
      match /reactions/{reactionId} {
        allow read: if isMember();
        allow create, update: if isMember()
          && request.resource.data.keys().hasOnly(['msg', 'uid', 'ct', 'iv', 'updatedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.msg is string
          && reactionId == request.resource.data.msg + '_' + request.auth.uid
          && request.resource.data.ct is string
          && request.resource.data.ct.size() <= 200
          && request.resource.data.iv is string
          && request.resource.data.iv.size() == 16
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      // "escribiendo…": solo la hora (o null). Cada quien solo el suyo.
      match /typing/{userId} {
        allow read: if isMember();
        allow create, update: if isMember()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['at'])
          && (request.resource.data.at == null || request.resource.data.at == request.time);
        allow delete: if false;
      }
    }

    // Biblioteca de stickers: los datos del archivo van cifrados. Se pueden
    // ocultar, nunca borrar.
    match /stickers/{stickerId} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['ct', 'iv', 'uid', 'createdAt', 'hidden'])
        && request.resource.data.ct is string
        && request.resource.data.ct.size() <= 2000
        && request.resource.data.iv is string
        && request.resource.data.iv.size() == 16
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.hidden == false;
      allow update: if isMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden'])
        && request.resource.data.hidden is bool;
      allow delete: if false;
    }

    // Pendientes: el texto va cifrado. Se marcan como hechos o se reabren;
    // nunca se borran.
    match /tasks/{taskId} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(
             ['chatId', 'ct', 'iv', 'createdBy', 'createdAt', 'done', 'doneBy', 'doneAt'])
        && request.resource.data.chatId is string
        && request.resource.data.chatId.size() > 0
        && request.resource.data.chatId.size() <= 64
        && request.resource.data.ct is string
        && request.resource.data.ct.size() <= 20000
        && request.resource.data.iv is string
        && request.resource.data.iv.size() == 16
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.done == false
        && request.resource.data.doneBy == null
        && request.resource.data.doneAt == null;
      allow update: if isMember()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['done', 'doneBy', 'doneAt'])
        && ((request.resource.data.done == true
              && request.resource.data.doneBy == request.auth.uid
              && request.resource.data.doneAt == request.time)
            || (request.resource.data.done == false
              && request.resource.data.doneBy == null
              && request.resource.data.doneAt == null));
      allow delete: if false;
    }

    // Archivos: trozos cifrados de hasta ~900 KB. No se editan ni se borran.
    match /files/{fileId}/chunks/{chunkId} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['data', 'iv', 'uid', 'createdAt'])
        && request.resource.data.data is bytes
        && request.resource.data.data.size() <= 1000000
        && request.resource.data.iv is string
        && request.resource.data.iv.size() == 16
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Hasta dónde leyó cada uno cada conversación (no leídos y "visto").
    // Cada quien solo escribe el suyo.
    match /users/{userId} {
      allow read: if isMember();
      allow create, update: if isMember()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['lastRead'])
        && request.resource.data.lastRead is map;
      allow delete: if false;
    }

    // Todo lo demás de la base de datos queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
