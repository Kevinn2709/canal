# Copia este archivo a .env (y a .env.local para el front) y rellena.
# .env y .env.local están en .gitignore: NUNCA se suben al repo público.

# --- Servidor relay ---
# Token de acceso. Genera uno fuerte, p.ej.:  openssl rand -hex 24
# Compártelo con tu contacto por un canal aparte (en persona, por voz).
ACCESS_TOKEN=pon_aqui_un_token_largo_y_aleatorio

# Origen permitido (tu front desplegado). CORS lo usa.
CLIENT_ORIGIN=http://localhost:3000

# TTL de respaldo para mensajes NO entregados (ms). Es distinto del borrado de
# 24h tras recibir (eso ocurre en el cliente). Default 7 días. Si el otro no se
# conecta en este plazo, el mensaje en cola se descarta. Ej. 1 día:
# UNDELIVERED_TTL_MS=86400000
UNDELIVERED_TTL_MS=604800000

# --- Front (Next.js) ---
# URL pública del relay.
NEXT_PUBLIC_RELAY_URL=http://localhost:4000
